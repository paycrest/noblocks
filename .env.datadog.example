# Datadog Agent credentials — copy to .env.datadog on the host.
#
# Consumed by docker-compose.datadog.yml only. The application container does
# NOT need DD_API_KEY: app code talks to the agent, and only the agent talks to
# Datadog. Keep this file out of git (.env* is already ignored).

# API key from the EU org: https://app.datadoghq.eu/organization-settings/api-keys
DD_API_KEY=

# Distinguishes hosts in the Datadog UI. Use a distinct value per environment.
DD_HOSTNAME=noblocks-prod

# Applied to every metric, trace and log the agent forwards.
DD_ENV=production
DD_TAGS=env:production service:noblocks
